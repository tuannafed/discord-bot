# ============================================================
# Discord
# ============================================================
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id

# For instant guild-scoped command registration during development.
# Comma-separated for multiple guilds, e.g. 111111111111111111,222222222222222222
# Omit (or leave empty) for global registration (~1 hour to propagate).
DISCORD_GUILD_ID=

# ============================================================
# Market Data
# ============================================================

# Required — CoinMarketCap API key (market cap, rankings, coin list)
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Optional — Bybit API key (real-time price enrichment for futures)
BYBIT_API_KEY=
BYBIT_SECRET_KEY=

# ============================================================
# Storage
# ============================================================

# PostgreSQL connection string (recommended for production / Railway).
# When set, all data is persisted in PostgreSQL.
# When unset, data is stored in JSON files under src/data/ (local dev only).
DATABASE_URL=

# Override the directory used for JSON file storage.
# Only relevant when DATABASE_URL is NOT set.
# Example for Railway Volume: DATA_DIR=/data
DATA_DIR=

# ============================================================
# Alerts
# ============================================================

# Minimum minutes between repeated notifications for the same alert (default: 60)
ALERT_COOLDOWN_MINUTES=60

# ============================================================
# Candidate Tracking
# ============================================================

# Market cap threshold to consider a candidate as "hit target" in USD (default: 1_000_000_000 = $1B)
CANDIDATE_TARGET_MARKET_CAP=1000000000

# Number of days to track a candidate before it expires (default: 7)
CANDIDATE_TRACKING_DAYS=7

# Minimum 24h price change % for a coin to be added as a candidate (default: 10)
CANDIDATE_MIN_CHANGE_24H=10

# Number of top gainers to scan during daily discovery (default: 100)
CANDIDATE_SCAN_SIZE=100

# Discord channel ID where candidate hit-target and discovery notifications are sent.
# Required for candidate alerts to work.
CANDIDATE_ALERT_CHANNEL_ID=

# ============================================================
# Optional — Chat khi @mention bot (LLM)
# ============================================================
ENABLE_AI_CHAT=true

# --- Claude (Anthropic) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-api03-...
LLM_BASE_URL=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_ANTHROPIC_VERSION=2023-06-01

# --- OpenAI / OpenRouter / Groq (mặc định nếu không dùng anthropic) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

LLM_SYSTEM_PROMPT=
LLM_COOLDOWN_MS=8000
LLM_MAX_TOKENS=600
